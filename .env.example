# OnionGrade AI Environment Configuration

# Flask Secret Key for session encryption
SECRET_KEY=oniongrade_ai_dev_secret_key_change_in_production_2026

# Database URI (SQLite for local dev, PostgreSQL for production)
# SQLite: sqlite:///instance/oniongrade.db
# PostgreSQL: postgresql://username:password@localhost:5432/oniongrade_db
DATABASE_URL=sqlite:///instance/oniongrade.db

# AI Model Configuration
DETECTION_MODEL=models/best.pt
CLASSIFICATION_MODEL=models/final_onion_quality_model.keras
CLASSIFIER_CONFIDENCE_THRESHOLD=0.50
YOLO_CONFIDENCE_THRESHOLD=0.25
MOCK_AI_MODE=False

# Live Mandi / Agmarknet Market API Configuration
# Paste your Government Data.gov.in API key below:
DATA_GOV_API_KEY=
MARKET_API_KEY=
MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MARKET_CACHE_TTL_SECONDS=300
DEFAULT_REFERENCE_MANDI=Lasalgaon

